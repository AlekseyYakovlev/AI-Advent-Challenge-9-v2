# Process ports
UI_PORT=8000
AGENT_PORT=8001

# Database
DB_PATH=app.db

# LLM Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LM_STUDIO_BASE_URL=http://localhost:1234
LLM_TIMEOUT=60.0
LLM_PROVIDER_CHECK_TIMEOUT=10.0
# Extra provider keys: add them here as NAME=value lines and reference only NAME in
# Settings -> Провайдеры LLM (the key value is never stored in the database or shown in the UI).
# OPENROUTER_API_KEY=your_openrouter_key_here

# MCP tool calls from chat
# Enabled MCP servers connect automatically at the first chat turn (false = manual connect only)
MCP_AUTO_CONNECT=true
MCP_TOOL_CALL_TIMEOUT=30.0
MCP_TOOL_RESULT_MAX_CHARS=20000

# RAG task memory
# Timeout in seconds for the post-turn task-memory extraction call
# TASK_MEMORY_TIMEOUT=30.0
# Eval-only switch: false disables task memory and history-aware query condensing
# TASK_MEMORY_ENABLED=true
